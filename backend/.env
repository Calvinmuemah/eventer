# =============================================================================
# EMAIL CONFIGURATION (Nodemailer / SMTP)
# =============================================================================
# How to set up with Gmail:
# 1. Sign in to your Google Account (e.g. mctitoeevents@gmail.com).
# 2. Go to "Security" -> Enable "2-Step Verification" if not already enabled.
# 3. Search for "App Passwords" (or navigate to Security -> App Passwords).
# 4. Create an App Password with name "MC Titoe Backend".
# 5. Copy the 16-character generated password and paste it into SMTP_PASS below.
# 6. Set SMTP_USER to your full Gmail address.
#
# How to set up with Custom Domain / Webmail / cPanel / Hostinger:
# Set SMTP_HOST to your mail host (e.g. mail.mctitoeevents.com or smtp.hostinger.com)
# Set SMTP_PORT to 465 (SSL) or 587 (TLS), and SMTP_USER / SMTP_PASS to your webmail credentials.
# =============================================================================

# SMTP server hostname (e.g. smtp.gmail.com, smtp.mailgun.org, mail.yourdomain.com)
SMTP_HOST=smtp.gmail.com

# SMTP server port: 465 for SSL, 587 for STARTTLS
SMTP_PORT=465

# Set to true for port 465, false for port 587
SMTP_SECURE=true

# Your sending email address / SMTP username
SMTP_USER=mctitoeeventsdesigns@gmail.com

# Your email password or 16-character Google App Password (NO SPACES)
SMTP_PASS=your_16_char_app_password_here

# Display name that recipients will see as sender
EMAIL_FROM_NAME="MC TITOE EVENTS AND DESIGNS"

# Sender address shown in the 'From' header
EMAIL_FROM_ADDRESS=mctitoeeventsdesigns@gmail.com

# Admin/Staff email where incoming inquiries and booking notifications will be copied
ADMIN_NOTIFICATION_EMAIL=mctitoeeventsdesigns@gmail.com
